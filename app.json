{
  "expo": {
    "name": "Bats View",
    "slug": "bats-view",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/76deb0f8-a3d1-434f-a103-ddc23cb344cd"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harsh16.batsview"
    },
    "android": {
      "package": "com.harsh16.batsview",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#210406"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#040711"
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-font",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "76deb0f8-a3d1-434f-a103-ddc23cb344cd"
      }
    },
    "owner": "harsh_16"
  }
}
