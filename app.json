{
  "expo": {
    "name": "Echolocation Game",
    "slug": "echolocation-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#040711"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.echolocation.game"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#040711"
      },
      "package": "com.echolocation.game"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-audio"
    ]
  }
}
